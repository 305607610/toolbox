{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "叮当",
  "mainBinaryName": "toolbox",
  "version": "0.1.0",
  "identifier": "com.toolbox.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "叮当",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#F6F6F4"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/pdfium.dll",
      "resources/pdfium-LICENSE.txt"
    ],
    "shortDescription": "叮当，一个 Windows 桌面工具合集。",
    "longDescription": "叮当把常用的小工具收进一个安静的 Windows 工作台。当前包含电子印章、图片压缩与 PDF 转 HTML。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}